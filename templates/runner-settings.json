{
  "_comment": "Least-privilege permissions for unattended /seo-agent:run sessions (scripts/schedule.sh passes this via --settings). Everything the skills need: git/gh for branches and PRs, node for the plugin scripts, php artisan for the sitemap, read-only shell tools, and file edits inside the product repo. Not allowed: rm, force-push, anything else — a denied tool fails that call and the run reports it. Widen deliberately, one pattern at a time.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "Skill",
      "WebFetch",
      "mcp__dataforseo__*",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(php artisan:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(xargs:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(python3:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)"
    ]
  }
}
