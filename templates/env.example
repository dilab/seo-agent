# seo-agent runner environment — sourced by scripts/schedule.sh before every headless run.
# Keep this file outside every repo (default location: ~/.config/seo-agent/env, mode 600).

# DataForSEO (keywords, analysis)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Search Console service-account key (feedback, discovery): a path, or the JSON on one line
GSC_SA_FILE=
#GSC_SA_JSON=

# Proxy, if your network needs one to reach googleapis.com (gsc.js honours it)
#https_proxy=http://127.0.0.1:7897

# Runner knobs (defaults shown)
#SEO_AGENT_MAX_SESSIONS=4
#SEO_AGENT_SESSION_TIMEOUT=5400
#SEO_AGENT_NOTIFY=1
